# Local Codex bridge. No OpenAI API key is required or accepted.
# Sign in with ChatGPT in the locally installed Codex runtime.
# Optional absolute path to the official Codex executable if auto-discovery fails.
FOUNDRY_CODEX_PATH=
# Native generations can take several minutes (allowed: 600000–1800000 ms).
FOUNDRY_CODEX_TIMEOUT_MS=600000
HOST=127.0.0.1
PORT=3001
FORGE_MAX_IN_FLIGHT=1
FORGE_RATE_LIMIT_PER_MINUTE=12
ENABLE_PROMPT_ORCHESTRATION=false
