GEMINI_API_KEY=

# Optional server auth tokens
FORGE_API_TOKEN=
INTERNAL_API_TOKEN=

# Optional security and runtime settings
CORS_ORIGIN=
ENABLE_PROMPT_ORCHESTRATION=false

# Optional per-route limits
FORGE_RATE_LIMIT_PER_MINUTE=12
CHARACTER_SHEET_RATE_LIMIT_PER_MINUTE=8
ACTION_ANIMATOR_RATE_LIMIT_PER_MINUTE=6
FORGE_MAX_IN_FLIGHT=3
CHARACTER_SHEET_MAX_IN_FLIGHT=2
ACTION_ANIMATOR_MAX_IN_FLIGHT=1

# Optional body size limits
FORGE_JSON_LIMIT=12mb
CHARACTER_SHEET_JSON_LIMIT=14mb
ACTION_ANIMATOR_JSON_LIMIT=8mb
